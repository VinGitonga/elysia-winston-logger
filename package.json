{
	"name": "@vingitonga/elysia-winston-logger",
	"version": "0.1.1",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"description": "Winston logger plugin for Elysia",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VinGitonga/elysia-winston-logger.git"
	},
	"bugs": {
		"url": "https://github.com/VinGitonga/elysia-winston-logger/issues"
	},
	"homepage": "https://github.com/VinGitonga/elysia-winston-logger#readme",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node && tsc",
		"prepublishOnly": "bun run build",
		"format": "biome format --write .",
		"lint": "biome lint --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/bun": "latest",
		"elysia": "^1.4.29",
		"typescript": "^5",
		"winston": "^3.19.0"
	},
	"peerDependencies": {
		"elysia": ">=1.4.0",
		"winston": ">=3.0.0"
	},
	"dependencies": {
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0"
	}
}
